      "fontSize": 20,
      "fontFamily": 1,
      "text": "api.workflow_specification WITH (security_invoker=true)\nSELECT id,version,definition,to_jsonb(published_at) AS publication\nFROM api.task_spec_catalog WHERE definition->>'workflow_handler'='bounded@1'\n\napi.workflow WITH (security_invoker=true)\nSELECT id,spec_id,state,seq,last_output,initiation_provenance,\n       intent->'members' AS children\nFROM api.task WHERE spec_id='bounded-workflow@1'",
      "originalText": "api.workflow_specification WITH (security_invoker=true)\nSELECT id,version,definition,to_jsonb(published_at) AS publication\nFROM api.task_spec_catalog WHERE definition->>'workflow_handler'='bounded@1'\n\napi.workflow WITH (security_invoker=true)\nSELECT id,spec_id,state,seq,last_output,initiation_provenance,\n       intent->'members' AS children\nFROM api.task WHERE spec_id='bounded-workflow@1'",
