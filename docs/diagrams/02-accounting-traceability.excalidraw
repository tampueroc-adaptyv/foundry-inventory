      "isDeleted": false,
      "boundElements": null,
      "updated": 1793710841841,
      "link": null,
      "locked": false,
      "text": "Solid arrows = declared FKs (child -> parent).\nPK = all six shown fields + tenant_id.\nPolymorphic target_type / target_id / selector:\nhandler-validated; NOT declared target FKs.",
      "originalText": "Solid arrows = declared FKs (child -> parent).\nPK = all six shown fields + tenant_id.\nPolymorphic target_type / target_id / selector:\nhandler-validated; NOT declared target FKs.",
